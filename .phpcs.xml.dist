<?xml version="1.0"?>
<ruleset name="mcp-api-keys">
	<description>WordPress-Extra plus PHP 7.4 compatibility, roughly what the WordPress.org plugin review looks for.</description>

	<file>mcp-api-keys.php</file>
	<file>uninstall.php</file>

	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
