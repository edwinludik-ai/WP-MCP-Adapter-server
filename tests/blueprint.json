{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/options-general.php?page=mcp-api-keys",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"login": true,
	"steps": [
		{ "step": "mkdir", "path": "/wordpress/wp-content/mu-plugins" },
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/enable-app-passwords.php",
			"data": "<?php add_filter( 'wp_is_application_passwords_available', '__return_true' );"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/mcp-adapter/releases/latest/download/mcp-adapter.zip"
			},
			"options": { "activate": true }
		}
	]
}
